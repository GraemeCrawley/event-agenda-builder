# Copy this file to .env and change what you need. Every line is optional.

# The folder holding your event's files (event.json, sessions.json...).
# Leave as-is to try the made-up sample event first.
# For your own event, make a folder inside events/ and point at it, e.g.:
#   EVENT_FOLDER=./events/my-conference
EVENT_FOLDER=./samples/example-event

# Port for the web page: http://localhost:8000
PORT=8000

# 127.0.0.1 = only this computer can open the page.
# 0.0.0.0   = other devices on your home Wi-Fi can open it too (see README).
BIND=127.0.0.1
